digraph G { graph [bgcolor="white",pad="0.25",nodesep="0.45",ranksep="0.65",fontname="Arial",label="LR08 Chain",labelloc=t,fontsize=16];  rankdir=LR; node [shape=record,fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; B [label="{«abstract» CollisionHandler|- next : CollisionHandler|+ SetNext(handler)\l+ Handle(game, point)\l# Check() : bool?}",style=filled,fillcolor="#e8f1fb"]; W [label="{WallCollisionHandler|# Check() : bool?}"]; C [label="{BodyCollisionHandler|# Check() : bool?}"]; W -> B [arrowhead=empty]; C -> B [arrowhead=empty]; B -> B [label="next",color="#b45f06"];  }