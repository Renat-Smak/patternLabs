digraph G { graph [bgcolor="white",pad="0.25",nodesep="0.45",ranksep="0.65",fontname="Arial",label="LR07 Command Iterator",labelloc=t,fontsize=16];  rankdir=LR; node [shape=record,fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; I [label="{«interface» IGameCommand|+ Execute(game) : void}",style=filled,fillcolor="#e8f1fb"]; T [label="{TurnCommand|- direction : Direction|+ Execute(game) : void}"]; M [label="{MoveCommand|+ Execute(game) : void}"]; Q [label="{CommandQueue|- queue : Queue<IGameCommand>|+ Add(command)\l+ ExecuteAll(game)}"]; It [label="{SnakeIterator|- body : IList<Point>\l- index : int|+ HasNext : bool\l+ Next() : Point}",style=filled,fillcolor="#fff2cc"]; T -> I [arrowhead=empty,style=dashed]; M -> I [arrowhead=empty,style=dashed]; Q -> I [arrowhead=odiamond,label="хранит команды"]; It -> P [label="перебирает элементы",style=dashed]; P [label="{Point|X : int\lY : int}"];  }