digraph G { graph [bgcolor="white",pad="0.25",nodesep="0.45",ranksep="0.65",fontname="Arial",label="LR09 Mediator Memento",labelloc=t,fontsize=16];  rankdir=LR; node [shape=record,fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; I [label="{«interface» IGameComponent|+ OnScoreChanged(score) : void}",style=filled,fillcolor="#e8f1fb"]; L [label="{ScoreLabel|+ OnScoreChanged(score)}"]; S [label="{SoundNotifier|+ OnScoreChanged(score)}"]; M [label="{GameMediator|- components : List<IGameComponent>|+ Register(component)\l+ NotifyScoreChanged(score)}",style=filled,fillcolor="#fff2cc"]; N [label="{GameMemento|Body : List<Point>\lFood : Point\lDirection : Direction\lScore : int\lStatus : GameStatus}"]; Snap [label="{GameSnapshot|+ Save(game) : GameMemento\l+ Restore(game, memento) : void}"]; L -> I [arrowhead=empty,style=dashed]; S -> I [arrowhead=empty,style=dashed]; M -> I [arrowhead=odiamond,label="оповещает"]; Snap -> N [style=dashed,label="создаёт / восстанавливает"];  }