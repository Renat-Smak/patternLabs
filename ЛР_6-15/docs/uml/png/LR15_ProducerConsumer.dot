digraph G { graph [bgcolor="white",pad="0.25",nodesep="0.45",ranksep="0.65",fontname="Arial",label="LR15 ProducerConsumer",labelloc=t,fontsize=16];  rankdir=LR; node [shape=record,fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; Prod [label="{Производитель|+ Produce(action)}",style=filled,fillcolor="#e8f1fb"]; Q [label="{BackgroundTaskQueue|- tasks : BlockingCollection<Action>\l- worker : Task|+ Produce(action)\l+ Stop()}",style=filled,fillcolor="#fff2cc"]; Cons [label="{Потребитель|+ Execute(action)}",style=filled,fillcolor="#e2f0d9"]; Prod -> Q [label="добавляет задачу"]; Q -> Cons [label="извлекает задачу"];  }