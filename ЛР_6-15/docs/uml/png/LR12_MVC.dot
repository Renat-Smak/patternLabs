digraph G { graph [bgcolor="white",pad="0.25",nodesep="0.45",ranksep="0.65",fontname="Arial",label="LR12 MVC",labelloc=t,fontsize=16];  rankdir=LR; node [shape=record,fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; M [label="{Model : SnakeModel|+ Game : SnakeGame\l+ Move(direction) : void}",style=filled,fillcolor="#e8f1fb"]; V [label="{View : SnakeView|+ Render(model) : void}",style=filled,fillcolor="#e8f1fb"]; C [label="{Controller : SnakeController|- model : SnakeModel\l- view : SnakeView|+ HandleInput(direction) : void}",style=filled,fillcolor="#fff2cc"]; C -> M [label="изменяет"]; C -> V [label="обновляет"]; V -> M [label="читает данные",style=dashed];  }