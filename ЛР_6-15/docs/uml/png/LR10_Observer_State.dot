digraph G { graph [bgcolor="white",pad="0.25",nodesep="0.45",ranksep="0.65",fontname="Arial",label="LR10 Observer State",labelloc=t,fontsize=16];  rankdir=LR; node [shape=record,fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; O [label="{«interface» IGameObserver|+ Update(message) : void}",style=filled,fillcolor="#e8f1fb"]; C [label="{ConsoleObserver|+ Update(message) : void}"]; E [label="{GameEventSource|- observers : List<IGameObserver>|+ Subscribe(observer)\l+ Notify(message)}",style=filled,fillcolor="#fff2cc"]; St [label="{«interface» IGameState|+ Handle(game) : void\l+ Name : string}",style=filled,fillcolor="#e8f1fb"]; P [label="{PlayingState|+ Handle(game)}"]; Pa [label="{PausedState|+ Handle(game)}"]; Go [label="{GameOverState|+ Handle(game)}"]; X [label="{GameStateContext|- state : IGameState|+ SetState(state)\l+ Request(game)}",style=filled,fillcolor="#fff2cc"]; C -> O [arrowhead=empty,style=dashed]; E -> O [arrowhead=odiamond,label="уведомляет"]; P -> St [arrowhead=empty,style=dashed]; Pa -> St [arrowhead=empty,style=dashed]; Go -> St [arrowhead=empty,style=dashed]; X -> St [label="текущее состояние"];  }